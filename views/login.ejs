<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - BUKUYA Cooperative</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-container">
    <div class="login-box">
      <div class="logo">
        <h2>🏦 BUKUYA Coop</h2>
        <p>Driver's Savings & Credit Society</p>
      </div>
      
      <h3 style="text-align:center;margin-bottom:20px;color:var(--primary);">Login</h3>
      
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      
      <form method="POST" action="/login">
        <div class="form-group">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" placeholder="Enter username" required autofocus>
        </div>
        
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" placeholder="Enter password" required>
        </div>
        
        <button type="submit" class="btn btn-primary btn-block">Login</button>
      </form>
      
      <div style="margin-top:20px;text-align:center;font-size:12px;color:var(--text-light);">
        <p>BUKUYA Driver's Savings & Credit Cooperative Society</p>
        <p style="margin-top:4px;">© 2024 All Rights Reserved</p>
      </div>
    </div>
  </div>
</body>
</html>
