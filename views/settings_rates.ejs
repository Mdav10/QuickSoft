<%- include('partials/header', { user: user, currentPage: 'settings' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">⚙️ Interest Rate Settings</h2>

  <!-- Savings Interest Rates -->
  <div class="card">
    <h3 style="margin-bottom:12px;font-size:16px;color:var(--primary);">📈 Savings Interest Rates</h3>
    <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">
      Configure interest rates for different savings durations.
    </p>
    <form method="POST" action="/settings/savings-rate">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Duration (Months)</label>
          <input type="number" name="duration_months" class="form-control" placeholder="e.g., 1, 3, 6, 12" required min="1">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Interest Rate (%)</label>
          <input type="number" name="interest_rate" class="form-control" placeholder="e.g., 3.0" required step="0.1" min="0">
        </div>
        <div style="display:flex;align-items:flex-end;">
          <button type="submit" class="btn btn-primary" style="padding:10px;">Save Rate</button>
        </div>
      </div>
    </form>
    
    <div style="margin-top:16px;">
      <h4 style="font-size:14px;color:var(--text-light);margin-bottom:8px;">Current Rates:</h4>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;">
        <% savingsRates.forEach(r => { %>
          <div style="background:#f8f9fa;padding:10px;border-radius:8px;text-align:center;">
            <div style="font-weight:700;font-size:16px;"><%= r.duration_months %> mo</div>
            <div style="color:var(--secondary);font-weight:600;"><%= r.interest_rate %>%</div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Loan Interest Rates -->
  <div class="card" style="margin-top:16px;">
    <h3 style="margin-bottom:12px;font-size:16px;color:var(--primary);">🏦 Loan Interest Rates</h3>
    <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">
      Configure interest rates for different loan repayment periods.
    </p>
    <form method="POST" action="/settings/loan-rate">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Repayment Period (Months)</label>
          <input type="number" name="repayment_period" class="form-control" placeholder="e.g., 1, 3, 6, 12" required min="1">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Interest Rate (%)</label>
          <input type="number" name="interest_rate" class="form-control" placeholder="e.g., 2.0" required step="0.1" min="0">
        </div>
        <div style="display:flex;align-items:flex-end;">
          <button type="submit" class="btn btn-primary" style="padding:10px;">Save Rate</button>
        </div>
      </div>
    </form>
    
    <div style="margin-top:16px;">
      <h4 style="font-size:14px;color:var(--text-light);margin-bottom:8px;">Current Rates:</h4>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;">
        <% loanRates.forEach(r => { %>
          <div style="background:#f8f9fa;padding:10px;border-radius:8px;text-align:center;">
            <div style="font-weight:700;font-size:16px;"><%= r.repayment_period %> mo</div>
            <div style="color:var(--secondary);font-weight:600;"><%= r.interest_rate %>%</div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'settings' }) %>
