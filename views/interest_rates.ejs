<%- include('partials/header', { user: user, currentPage: 'settings' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">💰 Loan Interest Settings</h2>

  <div class="card">
    <h3 style="margin-bottom:12px;font-size:15px;">Configure Interest Rates</h3>
    <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">
      Set interest rates for different repayment periods. Cashiers will use these rates when issuing loans.
    </p>
    <form method="POST" action="/settings/rates">
      <div class="form-group">
        <label class="form-label">Repayment Period (Months)</label>
        <input type="number" name="repayment_period" class="form-control" placeholder="e.g., 1, 3, 6, 12" required min="1">
      </div>
      <div class="form-group">
        <label class="form-label">Interest Rate (%)</label>
        <input type="number" name="interest_rate" class="form-control" placeholder="e.g., 2.5" required step="0.1" min="0">
      </div>
      <button type="submit" class="btn btn-primary">Save/Update Rate</button>
    </form>
  </div>

  <div class="card" style="padding:0;overflow:hidden;">
    <h3 style="padding:12px 16px;margin:0;background:var(--primary);color:white;font-size:15px;">Current Rates</h3>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Period (Months)</th>
            <th>Interest Rate</th>
          </tr>
        </thead>
        <tbody>
          <% if (rates && rates.length > 0) { %>
            <% rates.forEach(r => { %>
              <tr>
                <td><strong><%= r.repayment_period %></strong></td>
                <td><span class="badge badge-success"><%= r.interest_rate %>%</span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="2" style="text-align:center;padding:30px 0;color:var(--text-light);">
                No interest rates configured
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'settings' }) %>
