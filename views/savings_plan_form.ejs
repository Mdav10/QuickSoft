<%- include('partials/header', { user: user, currentPage: 'savings' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">📈 Create Savings Plan</h2>

  <div class="card">
    <div style="background:#f8f9fa;padding:12px;border-radius:8px;margin-bottom:16px;font-size:13px;color:var(--text-light);">
      <strong>💡 Savings Plans:</strong><br>
      • 1 Month: 3% interest<br>
      • 3 Months: 5% interest<br>
      • 6 Months: 8% interest<br>
      • 12 Months: 10% interest
    </div>
    <form method="POST" action="/savings/plans">
      <div class="form-group">
        <label class="form-label">Select Member *</label>
        <select name="customer_id" class="form-control" required>
          <option value="">Choose a member...</option>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.full_name %> (<%= c.account_number %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Savings Duration *</label>
        <select name="duration_months" class="form-control" required>
          <option value="">Select duration...</option>
          <% rates.forEach(r => { %>
            <option value="<%= r.duration_months %>">
              <%= r.duration_months %> months - <%= r.interest_rate %>% interest
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Initial Deposit (UGX) *</label>
        <input type="number" name="amount" class="form-control" placeholder="Enter amount" min="1" step="any" required>
      </div>

      <div style="display:flex;gap:12px;margin-top:20px;">
        <button type="submit" class="btn btn-primary">Create Savings Plan</button>
        <a href="/savings/plans" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'savings' }) %>
