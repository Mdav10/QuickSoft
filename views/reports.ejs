<%- include('partials/header', { user: user, currentPage: 'reports' }) %>

<div class="container">
  <div style="background:linear-gradient(135deg, #0a2b4e, #061a30);color:white;border-radius:12px;padding:8px 16px;margin-bottom:16px;text-align:center;">
    <span style="font-size:13px;">📅 <span id="reportDate"><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span></span>
    <span style="font-size:15px;font-weight:600;margin-left:12px;">🕐 <span id="reportTime"><%= new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }) %></span></span>
  </div>

  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">📊 Reports</h2>

  <div class="card">
    <h3 style="margin-bottom:12px;font-size:16px;">📅 Generate Report</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <a href="/reports/daily" class="btn btn-primary" style="padding:16px;">
        <span style="display:block;font-size:28px;margin-bottom:4px;">📋</span>
        Daily
      </a>
      <a href="/reports/daily?period=weekly" class="btn btn-secondary" style="padding:16px;">
        <span style="display:block;font-size:28px;margin-bottom:4px;">📅</span>
        Weekly
      </a>
      <a href="/reports/daily?period=monthly" class="btn btn-success" style="padding:16px;">
        <span style="display:block;font-size:28px;margin-bottom:4px;">📆</span>
        Monthly
      </a>
      <% if (user && user.role === 'manager') { %>
        <a href="/reports/daily?period=annual" class="btn btn-warning" style="padding:16px;">
          <span style="display:block;font-size:28px;margin-bottom:4px;">📊</span>
          Annual
        </a>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h3 style="margin-bottom:12px;font-size:16px;">📄 Quick Reports</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <a href="/reports/daily" class="btn btn-outline" style="padding:12px;">Today's Report</a>
      <a href="/loans" class="btn btn-outline" style="padding:12px;">Active Loans</a>
      <a href="/savings/plans" class="btn btn-outline" style="padding:12px;">Savings Plans</a>
      <a href="/expenses" class="btn btn-outline" style="padding:12px;">Expense Report</a>
    </div>
  </div>

  <% if (user && user.role === 'manager') { %>
    <div class="card" style="border:2px solid var(--primary);">
      <h3 style="margin-bottom:12px;font-size:16px;color:var(--primary);">⚙️ Manager Reports</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <a href="/audit" class="btn btn-secondary" style="padding:12px;">📋 Audit Log</a>
        <a href="/settings/rates" class="btn btn-secondary" style="padding:12px;">💰 Interest Rates</a>
      </div>
    </div>
  <% } %>
</div>

<script>
// Update time every second
function updateTime() {
  const now = new Date();
  const timeStr = now.toLocaleTimeString('en-US', { 
    hour: '2-digit', 
    minute: '2-digit',
    second: '2-digit',
    hour12: false 
  });
  const dateStr = now.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
  
  const timeElement = document.getElementById('reportTime');
  const dateElement = document.getElementById('reportDate');
  if (timeElement) timeElement.textContent = timeStr;
  if (dateElement) dateElement.textContent = dateStr;
}
setInterval(updateTime, 1000);
</script>

<%- include('partials/footer', { user: user, currentPage: 'reports' }) %>
