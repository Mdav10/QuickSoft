<%- include('partials/header', { user: user, currentPage: 'savings' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">💰 Add to Savings</h2>

  <div class="card">
    <form method="POST" action="/savings/deposit">
      <div class="form-group">
        <label class="form-label">Select Member *</label>
        <select name="customer_id" class="form-control" required>
          <option value="">Choose a member...</option>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>" <%= customer_id === c.id ? 'selected' : '' %>>
              <%= c.full_name %> (<%= c.account_number %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Amount (UGX) *</label>
        <input type="number" name="amount" class="form-control" placeholder="Enter amount" min="1" step="any" required>
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <input type="text" name="description" class="form-control" placeholder="Optional description">
      </div>

      <div style="display:flex;gap:12px;margin-top:20px;">
        <button type="submit" class="btn btn-success">Process Deposit</button>
        <a href="/savings/plans" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>

  <div class="card" style="background:#f8f9fa;">
    <h4 style="font-size:14px;color:var(--text-light);margin-bottom:8px;">📊 Savings Interest Rates</h4>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px;">
      <div>1 Month: <span class="badge badge-success">3%</span></div>
      <div>3 Months: <span class="badge badge-success">5%</span></div>
      <div>6 Months: <span class="badge badge-success">8%</span></div>
      <div>12 Months: <span class="badge badge-success">10%</span></div>
    </div>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'savings' }) %>
