<%- include('partials/header', { user: user, currentPage: 'expenses' }) %>

<div class="container">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
    <h2 style="color:var(--primary);font-size:18px;">📝 Expenses</h2>
    <a href="/expenses/new" class="btn btn-primary" style="width:auto;padding:8px 16px;font-size:13px;">+ Add Expense</a>
  </div>

  <div class="card" style="padding:0;overflow:hidden;">
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Cashier</th>
            <th>Date</th>
            <th style="text-align:center;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (expenses && expenses.length > 0) { %>
            <% expenses.forEach(e => { %>
              <tr>
                <td>
                  <strong><%= e.expense_name %></strong>
                  <span style="font-size:11px;color:var(--text-light);display:block;"><%= e.description || 'No description' %></span>
                </td>
                <td style="font-weight:600;color:#dc3545;">UGX <%= parseFloat(e.amount).toLocaleString() %></td>
                <td><%= e.cashier_name || 'System' %></td>
                <td style="font-size:12px;">
                  <%= new Date(e.created_at).toLocaleDateString() %>
                  <span style="color:var(--text-light);display:block;font-size:10px;">
                    <%= new Date(e.created_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit', hour12: false}) %>
                  </span>
                </td>
                <td style="text-align:center;">
                  <% if (user && user.role === 'manager') { %>
                    <button onclick="confirmDelete('/expenses/<%= e.id %>/delete', 'expense', '<%= e.expense_name %> - UGX <%= parseFloat(e.amount).toLocaleString() %>')" 
                            class="btn btn-sm btn-danger" style="width:auto;min-height:30px;padding:4px 10px;" title="Delete Expense">
                      🗑️
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align:center;padding:30px 0;color:var(--text-light);">
                No expenses recorded
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;padding:20px;">
  <div style="background:white;border-radius:12px;padding:24px;max-width:400px;width:100%;">
    <h3 style="margin-bottom:12px;color:#dc3545;">⚠️ Confirm Delete</h3>
    <p id="deleteMessage" style="color:var(--text-light);margin-bottom:16px;"></p>
    <form id="deleteForm" method="POST" action="">
      <div style="display:flex;gap:12px;">
        <button type="submit" class="btn btn-danger" style="flex:1;">Delete</button>
        <button type="button" onclick="closeDelete()" class="btn btn-outline" style="flex:1;">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
function confirmDelete(url, type, name) {
  document.getElementById('deleteMessage').textContent = `Are you sure you want to delete this ${type} "${name}"? This action cannot be undone.`;
  document.getElementById('deleteForm').action = url;
  document.getElementById('deleteModal').style.display = 'flex';
}

function closeDelete() {
  document.getElementById('deleteModal').style.display = 'none';
}

// Close modal when clicking outside
document.getElementById('deleteModal').addEventListener('click', function(e) {
  if (e.target === this) closeDelete();
});

// Close modal with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeDelete();
});
</script>

<%- include('partials/footer', { user: user, currentPage: 'expenses' }) %>
