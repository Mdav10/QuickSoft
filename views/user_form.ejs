<%- include('partials/header', { user: user, currentPage: 'users' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">👤 Add New Cashier</h2>

  <div class="card">
    <form method="POST" action="/users">
      <div class="form-group">
        <label class="form-label">Full Name *</label>
        <input type="text" name="full_name" class="form-control" placeholder="Enter full name" required>
      </div>

      <div class="form-group">
        <label class="form-label">Username *</label>
        <input type="text" name="username" class="form-control" placeholder="Enter username" required>
      </div>

      <div class="form-group">
        <label class="form-label">Password *</label>
        <input type="password" name="password" class="form-control" placeholder="Enter password" required minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label">Phone Number</label>
        <input type="tel" name="phone" class="form-control" placeholder="Enter phone number">
      </div>

      <div style="display:flex;gap:12px;margin-top:20px;">
        <button type="submit" class="btn btn-primary">Create Cashier</button>
        <a href="/users" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'users' }) %>
