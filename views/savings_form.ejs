<%- include('partials/header', { user: user, currentPage: 'savings' }) %>

<div class="container">
  <h2 style="color:var(--primary);font-size:18px;margin-bottom:16px;">
    <%= type === 'deposit' ? '💰 New Deposit' : '💳 New Withdrawal' %>
  </h2>

  <div class="card">
    <form method="POST" action="/savings">
      <input type="hidden" name="type" value="<%= type %>">
      
      <div class="form-group">
        <label class="form-label">Select Member *</label>
        <select name="customer_id" class="form-control" required>
          <option value="">Choose a member...</option>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.full_name %> (<%= c.account_number %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Amount (UGX) *</label>
        <input type="number" name="amount" class="form-control" placeholder="Enter amount" min="1" step="100" required>
      </div>

      <div class="form-group">
        <label class="form-label">Description</label>
        <input type="text" name="description" class="form-control" placeholder="Optional description">
      </div>

      <div style="display:flex;gap:12px;margin-top:20px;">
        <button type="submit" class="btn <%= type === 'deposit' ? 'btn-success' : 'btn-danger' %>">
          <%= type === 'deposit' ? 'Process Deposit' : 'Process Withdrawal' %>
        </button>
        <a href="/savings" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer', { user: user, currentPage: 'savings' }) %>
